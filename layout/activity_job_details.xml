<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <!-- Note Text Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/noteText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Add a note"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="5"
            android:scrollbars="vertical" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Call Pro Button -->
    <ImageButton
        android:id="@+id/callProButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@null"
        android:src="@drawable/baseline_call_24"
        app:tint="@color/mowie_green"
        app:layout_constraintTop_toBottomOf="@id/noteText"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Text Pro Button -->
    <ImageButton
        android:id="@+id/textProButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@null"
        android:src="@drawable/baseline_textsms_24"
        app:tint="@color/mowie_green"
        app:layout_constraintTop_toBottomOf="@id/noteText"
        app:layout_constraintStart_toEndOf="@id/callProButton" />

    <!-- Job Note Button -->
    <Button
        android:id="@+id/jobNoteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save Note"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/callProButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Payment Button -->
    <Button
        android:id="@+id/paymentButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        android:text="Proceed to Payment"
        app:layout_constraintTop_toBottomOf="@id/jobNoteButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
