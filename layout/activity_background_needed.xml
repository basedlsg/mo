<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/system_white"
    android:fitsSystemWindows="true" >

    <!-- Logo at the Top -->
    <ImageView
        android:id="@+id/backgroundlogoImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_mowie"
        android:contentDescription="App Logo"
        android:layout_marginBottom="16dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/backgroundtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Background Check Processing"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="12dp" />

    <!-- Description -->
    <TextView
        android:id="@+id/backgrounddescriptionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A successful background check is required to proceed."
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Resend Request Button -->
        <Button
            android:id="@+id/supportRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email Support"
            android:backgroundTint="@color/mowie_green"
            android:textColor="@color/white"
            android:layout_marginBottom="12dp" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/backgroundLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:backgroundTint="@color/system_blue"
            android:textColor="@color/white"
            android:layout_marginBottom="12dp"/>

        <!-- Delete Account Button -->
        <Button
            android:id="@+id/deleteAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Account"
            android:backgroundTint="@color/system_red"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
